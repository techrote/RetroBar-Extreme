// RetroBar-Extreme example style: Synthwave.
// Shows: A checker turned 45 degrees into an argyle grid, magenta-to-violet buttons, a cyan
// active button and a horizontal sunset gradient on the tray.
// Font to try: Sling Arc (bundled; Properties > Style > Font).
// Use it from Properties > Colours > Saved styles, or Import... this file.
{
  "name": "Synthwave",
  "parts": {
    "bar": {
      "background": {
        "texture": "checker",
        "lut": [
          "#1a0530",
          "#400e6c"
        ],
        "scale": 2,
        "angle": 45
      },
      "border": "#ff2a8a"
    },
    "tray": {
      "background": {
        "angle": 0,
        "stops": [
          "#3a0a5e",
          "#c0207a",
          "#ff7a3a"
        ]
      },
      "border": "#ff2a8a"
    },
    "button": {
      "background": {
        "angle": 90,
        "stops": [
          "#c0207a",
          "#5a108a"
        ]
      },
      "border": "#ff70c0",
      "foreground": "#ffffff"
    },
    "buttonHover": {
      "background": {
        "angle": 90,
        "stops": [
          "#e03090",
          "#6a18a0"
        ]
      },
      "border": "#ffffff"
    },
    "buttonActive": {
      "background": {
        "angle": 90,
        "stops": [
          "#00f0ff",
          "#1060c0"
        ]
      },
      "border": "#c0fcff",
      "foreground": "#08001a"
    },
    "buttonFlashing": {
      "background": {
        "angle": 90,
        "stops": [
          "#ffe000",
          "#ff7a00"
        ]
      },
      "border": "#fff6b0",
      "foreground": "#2a0830"
    },
    "clock": {
      "foreground": "#00f0ff"
    },
    "bevel": {
      "highlight": "#ff70c0",
      "light": "#c0207a",
      "shadow": "#1a0530",
      "darkShadow": "#08001a"
    }
  },
  "start": {
    "recolour": "#ff2a8a"
  },
  "palette": [ "#ff2a8a", "#c0207a", "#1a0530", "#ff70c0", "#ffffff", "#00f0ff", "#08001a", "#400e6c", null, null, null, null ],
  "texturePalette": [
    {"texture": "checker", "lut": ["#1a0530", "#400e6c"], "scale": 2, "angle": 45},
    {"texture": "carbon", "lut": ["#08001a", "#c0207a", "#00f0ff"], "scale": 1, "contrast": 1},
    {"texture": "diamond", "lut": ["#1a0530", "#ff2a8a", "#ffffff"], "scale": 1, "contrast": 1},
    {"texture": "clouds", "lut": ["#00f0ff", "#ff2a8a", "#400e6c"], "scale": 2, "contrast": 1, "octaves": 4},
    {"texture": "cells", "lut": ["#c0207a", "#ff70c0", "#ffffff"], "scale": 1, "contrast": 1},
    {"texture": "marble", "lut": ["#ff2a8a", "#ff70c0", "#00f0ff"], "scale": 1, "contrast": 1, "frequency": 3, "strength": 1.5},
    {"texture": "scanlines", "lut": ["#ffffff", "#00f0ff", "#ff70c0"], "scale": 1, "contrast": 1, "frequency": 32},
    {"texture": "weave", "lut": ["#08001a", "#c0207a", "#00f0ff"], "scale": 1, "contrast": 1},
    {"texture": "checker", "lut": ["#1a0530", "#ff2a8a", "#ffffff"], "scale": 1, "contrast": 0.6, "frequency": 16},
    {"texture": "waves", "lut": ["#00f0ff", "#ff2a8a", "#400e6c"], "scale": 1, "contrast": 1, "frequency": 3, "octaves": 3},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
