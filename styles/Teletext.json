// RetroBar-Extreme example style: Teletext.
// Shows: Flat black with the eight teletext colours: no gradients, square edges, and a
// yellow-on-blue active button.
// Font to try: Null Cartridge (bundled; Properties > Style > Font).
// Use it from Properties > Colours > Saved styles, or Import... this file.
{
  "name": "Teletext",
  "parts": {
    "bar": {
      "background": "#000000",
      "border": "#000000"
    },
    "tray": {
      "background": "#000000",
      "border": "#00ff00"
    },
    "button": {
      "background": "#000000",
      "border": "#00ffff",
      "foreground": "#ffffff"
    },
    "buttonHover": {
      "background": "#000080",
      "border": "#ffffff"
    },
    "buttonActive": {
      "background": "#0000ff",
      "border": "#ffff00",
      "foreground": "#ffff00"
    },
    "buttonFlashing": {
      "background": "#ff0000",
      "border": "#ffffff",
      "foreground": "#ffffff"
    },
    "clock": {
      "foreground": "#ffff00"
    },
    "bevel": {
      "highlight": "#00ffff",
      "light": "#0000ff",
      "shadow": "#000000",
      "darkShadow": "#000000"
    }
  },
  "borders": {
    "bar": 0
  },
  "palette": [ "#000000", "#ff0000", "#00ff00", "#ffff00", "#0000ff", "#ff00ff", "#00ffff", "#ffffff", null, null, null, null ],
  "texturePalette": [
    {"texture": "waves", "lut": ["#000000", "#ff00ff", "#ffff00"], "scale": 1, "contrast": 1, "frequency": 3, "octaves": 3},
    {"texture": "bricks", "lut": ["#0000ff", "#00ff00", "#ffffff"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "dots", "lut": ["#ffff00", "#00ff00", "#ff0000"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "noise", "lut": ["#ff00ff", "#00ffff", "#ffffff"], "scale": 1, "contrast": 1, "strength": 0.6},
    {"texture": "brushed", "lut": ["#00ff00", "#00ffff", "#ffff00"], "scale": 1, "contrast": 1.2, "strength": 0.6},
    {"texture": "carbon", "lut": ["#ffffff", "#ffff00", "#00ffff"], "scale": 1, "contrast": 1},
    {"texture": "diamond", "lut": ["#000000", "#ff00ff", "#ffff00"], "scale": 1, "contrast": 1},
    {"texture": "clouds", "lut": ["#0000ff", "#00ff00", "#ffffff"], "scale": 2, "contrast": 1, "octaves": 4},
    {"texture": "cells", "lut": ["#ffff00", "#00ff00", "#ff0000"], "scale": 1, "contrast": 1},
    {"texture": "marble", "lut": ["#ff00ff", "#00ffff", "#ffffff"], "scale": 1, "contrast": 1, "frequency": 3, "strength": 1.5},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
