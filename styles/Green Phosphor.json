// RetroBar-Extreme example style: Green Phosphor.
// Shows: noise texture glow on the bar, a palette-coloured texture on the tray (it follows the
// palette slots), green-on-black terminal colours.
{
  "name": "Green Phosphor",
  "parts": {
    "bar": {
      "background": { "texture": "noise", "lut": [ "#000800", "#002a08", "#004810" ], "scale": 1, "contrast": 0.5 },
      "border": "#20ff60"
    },
    "tray": {
      "background": { "texture": "scanlines", "lut": [ "#000800", "#00300c" ], "scale": 0.5, "contrast": 1 },
      "border": "#20ff60"
    },
    "button": {
      "background": { "angle": 90, "stops": [ "#002a08", "#001404" ] },
      "border": "#108030",
      "foreground": "#40ff80"
    },
    "buttonHover": {
      "background": { "angle": 90, "stops": [ "#004810", "#002a08" ] },
      "border": "#40ff80"
    },
    "buttonActive": {
      "background": { "angle": 90, "stops": [ "#40ff80", "#10a040" ] },
      "border": "#c0ffd0",
      "foreground": "#001404"
    },
    "buttonFlashing": {
      "background": { "angle": 90, "stops": [ "#ffff60", "#a0a000" ] },
      "border": "#000000",
      "foreground": "#000000"
    },
    "clock": { "foreground": "#40ff80" },
    "bevel": { "highlight": "#108030", "light": "#004810", "shadow": "#000000", "darkShadow": "#000000" }
  },
  "start": { "recolour": "#20c050" },
  "palette": [ "#000800", "#00300c", "#40ff80", "#20ff60", "#108030", "#10a040", "#c0ffd0", "#ffff60", null, null, null, null ],
  "texturePalette": [
    {"texture": "noise", "lut": ["#000800", "#002a08", "#004810"], "scale": 1, "contrast": 0.5},
    {"texture": "scanlines", "lut": ["#000800", "#00300c"], "scale": 0.5, "contrast": 1},
    {"texture": "waves", "lut": ["#000800", "#10a040", "#c0ffd0"], "scale": 1, "contrast": 1, "frequency": 3, "octaves": 3},
    {"texture": "bricks", "lut": ["#00300c", "#20ff60", "#ffff60"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "dots", "lut": ["#c0ffd0", "#20ff60", "#108030"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "noise", "lut": ["#10a040", "#40ff80", "#ffff60"], "scale": 1, "contrast": 1, "strength": 0.6},
    {"texture": "brushed", "lut": ["#20ff60", "#40ff80", "#c0ffd0"], "scale": 1, "contrast": 1.2, "strength": 0.6},
    {"texture": "carbon", "lut": ["#ffff60", "#c0ffd0", "#40ff80"], "scale": 1, "contrast": 1},
    {"texture": "diamond", "lut": ["#000800", "#10a040", "#c0ffd0"], "scale": 1, "contrast": 1},
    {"texture": "clouds", "lut": ["#00300c", "#20ff60", "#ffff60"], "scale": 2, "contrast": 1, "octaves": 4},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
