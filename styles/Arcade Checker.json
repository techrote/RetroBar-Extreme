// RetroBar-Extreme example style: Arcade Checker.
// Shows: A chequered bar (the checker texture), arcade neon buttons, a tray texture coloured
// from the palette, double-thick button borders and a hot-pink Start recolour.
// Font to try: Pixel Cell (bundled; Properties > Style > Font).
// Use it from Properties > Colours > Saved styles, or Import... this file.
{
  "name": "Arcade Checker",
  "parts": {
    "bar": {
      "background": {
        "texture": "checker",
        "lut": [
          "#101030",
          "#26265e"
        ],
        "scale": 2
      },
      "border": "#00e5ff"
    },
    "tray": {
      "background": {
        "texture": "checker",
        "lut": [ "#14143a", "#22225a" ],
        "scale": 1,
        "contrast": 0.6
      },
      "border": "#00e5ff"
    },
    "button": {
      "background": {
        "angle": 90,
        "stops": [
          "#2c2c70",
          "#1a1a46"
        ]
      },
      "border": "#5a5ad0",
      "foreground": "#ffe040"
    },
    "buttonHover": {
      "background": {
        "angle": 90,
        "stops": [
          "#3a3a90",
          "#24245c"
        ]
      },
      "border": "#00e5ff"
    },
    "buttonActive": {
      "background": {
        "angle": 90,
        "stops": [
          "#ff2a6d",
          "#b0104a"
        ]
      },
      "border": "#ffd0e0",
      "foreground": "#ffffff"
    },
    "buttonFlashing": {
      "background": {
        "angle": 90,
        "stops": [
          "#ffe040",
          "#ff9a00"
        ]
      },
      "border": "#fff6c0",
      "foreground": "#1a1030"
    },
    "clock": {
      "foreground": "#00e5ff"
    },
    "bevel": {
      "highlight": "#8080ff",
      "light": "#4a4ab0",
      "shadow": "#0a0a24",
      "darkShadow": "#000000"
    }
  },
  "start": {
    "recolour": "#ff2a6d"
  },
  "borders": {
    "button": 2,
    "buttonActive": 2,
    "buttonFlashing": 2
  },
  "palette": [ "#14143a", "#22225a", "#00e5ff", "#ffe040", "#ff2a6d", "#5a5ad0", "#3a3a90", "#b0104a", null, null, null, null ],
  "texturePalette": [
    {"texture": "checker", "lut": ["#101030", "#26265e"], "scale": 2},
    {"texture": "checker", "lut": ["#14143a", "#22225a"], "scale": 1, "contrast": 0.6},
    {"texture": "checker", "lut": ["#14143a", "#b0104a", "#00e5ff"], "scale": 1, "contrast": 0.6, "frequency": 16},
    {"texture": "waves", "lut": ["#22225a", "#5a5ad0", "#ffe040"], "scale": 1, "contrast": 1, "frequency": 3, "octaves": 3},
    {"texture": "bricks", "lut": ["#00e5ff", "#5a5ad0", "#3a3a90"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "dots", "lut": ["#b0104a", "#ff2a6d", "#ffe040"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "noise", "lut": ["#5a5ad0", "#ff2a6d", "#00e5ff"], "scale": 1, "contrast": 1, "strength": 0.6},
    {"texture": "brushed", "lut": ["#ffe040", "#00e5ff", "#ff2a6d"], "scale": 1, "contrast": 1.2, "strength": 0.6},
    {"texture": "carbon", "lut": ["#14143a", "#b0104a", "#00e5ff"], "scale": 1, "contrast": 1},
    {"texture": "diamond", "lut": ["#22225a", "#5a5ad0", "#ffe040"], "scale": 1, "contrast": 1},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
