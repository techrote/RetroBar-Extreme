// RetroBar-Extreme example style: Blueprint.
// Shows: A drafting grid (a soft, large checker) in blueprint blue, white linework and a
// pencil-yellow flashing button.
// Font to try: Latchline Mono (bundled; Properties > Style > Font).
// Use it from Properties > Colours > Saved styles, or Import... this file.
{
  "name": "Blueprint",
  "parts": {
    "bar": {
      "background": {
        "texture": "checker",
        "lut": [
          "#0b3d91",
          "#1454b0"
        ],
        "scale": 4,
        "contrast": 0.8
      },
      "border": "#cfe3ff"
    },
    "tray": {
      "background": {
        "angle": 90,
        "stops": [
          "#0f4aa8",
          "#0b3d91"
        ]
      },
      "border": "#cfe3ff"
    },
    "button": {
      "background": "#0b3d91",
      "border": "#cfe3ff",
      "foreground": "#ffffff"
    },
    "buttonHover": {
      "background": "#14509f",
      "border": "#ffffff"
    },
    "buttonActive": {
      "background": "#1a5fd0",
      "border": "#ffffff",
      "foreground": "#ffffff"
    },
    "buttonFlashing": {
      "background": "#ffd23f",
      "border": "#fff3c0",
      "foreground": "#0b2a5e"
    },
    "clock": {
      "foreground": "#cfe3ff"
    },
    "bevel": {
      "highlight": "#cfe3ff",
      "light": "#6a9ae0",
      "shadow": "#07285e",
      "darkShadow": "#041a40"
    }
  },
  "palette": [ "#cfe3ff", "#ffffff", "#0b3d91", "#1454b0", "#1a5fd0", "#ffd23f", "#fff3c0", "#0b2a5e", null, null, null, null ],
  "texturePalette": [
    {"texture": "checker", "lut": ["#0b3d91", "#1454b0"], "scale": 4, "contrast": 0.8},
    {"texture": "weave", "lut": ["#0b2a5e", "#1a5fd0", "#fff3c0"], "scale": 1, "contrast": 1},
    {"texture": "checker", "lut": ["#0b3d91", "#ffd23f", "#ffffff"], "scale": 1, "contrast": 0.6, "frequency": 16},
    {"texture": "waves", "lut": ["#fff3c0", "#ffd23f", "#1454b0"], "scale": 1, "contrast": 1, "frequency": 3, "octaves": 3},
    {"texture": "bricks", "lut": ["#1a5fd0", "#cfe3ff", "#ffffff"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "dots", "lut": ["#ffd23f", "#cfe3ff", "#fff3c0"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "noise", "lut": ["#ffffff", "#fff3c0", "#cfe3ff"], "scale": 1, "contrast": 1, "strength": 0.6},
    {"texture": "brushed", "lut": ["#0b2a5e", "#1a5fd0", "#fff3c0"], "scale": 1, "contrast": 1.2, "strength": 0.6},
    {"texture": "carbon", "lut": ["#0b3d91", "#ffd23f", "#ffffff"], "scale": 1, "contrast": 1},
    {"texture": "diamond", "lut": ["#fff3c0", "#ffd23f", "#1454b0"], "scale": 1, "contrast": 1},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
