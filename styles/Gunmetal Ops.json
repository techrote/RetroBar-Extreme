    "clock": {
      "foreground": "#18c8ff"
    },
    "bevel": {
      "highlight": "#8a9aa8",
      "light": "#56636f",
      "shadow": "#101418",
      "darkShadow": "#000000"
    }
  },
  "start": {
    "recolour": "#3a5a74"
  },
  "borders": {
    "bar": 2,
    "tray": 2
  },
  "palette": [ "#56636f", "#8a9aa8", "#18c8ff", "#1c2228", "#384450", "#d8e4ee", "#0a7ab0", "#b0ecff", null, null, null, null ],
