// RetroBar-Extreme example style: Ocean Depths.
// Shows: a three-stop vertical gradient bar, a cellular "caustics" texture on the tray, and
// teal accents.
{
  "name": "Ocean Depths",
  "parts": {
    "bar": {
      "background": { "angle": 90, "stops": [ "#1a6a8a", "#0c3a5a", "#041a30" ] },
      "border": "#40d0e0"
    },
    "tray": {
      "background": { "texture": "cells", "lut": [ "#02101e", "#0c3a5a", "#40a8c0" ], "scale": 1.5, "contrast": 1 },
      "border": "#40d0e0"
    },
    "button": {
      "background": { "angle": 90, "stops": [ "#1c5878", "#0e3450" ] },
      "border": "#041a30",
      "foreground": "#e0f8ff"
    },
    "buttonHover": {
      "background": { "angle": 90, "stops": [ "#2a7898", "#164868" ] },
      "border": "#40d0e0"
    },
    "buttonActive": {
      "background": { "angle": 90, "stops": [ "#06223a", "#0c3a5a" ] },
      "border": "#40d0e0",
      "foreground": "#60f0ff"
    },
    "buttonFlashing": {
      "background": { "angle": 90, "stops": [ "#ff9060", "#c04820" ] },
      "border": "#401000",
      "foreground": "#ffffff"
    },
    "clock": { "foreground": "#60f0ff" },
    "bevel": { "highlight": "#60b0d0", "light": "#2a7898", "shadow": "#041a30", "darkShadow": "#000810" }
  },
  "start": { "recolour": "#1a8aa8" },
  "palette": [ "#1c5878", "#40d0e0", "#041a30", "#60f0ff", "#0c3a5a", "#2a7898", "#40a8c0", "#e0f8ff", null, null, null, null ],
  "texturePalette": [
    {"texture": "cells", "lut": ["#02101e", "#0c3a5a", "#40a8c0"], "scale": 1.5, "contrast": 1},
    {"texture": "bricks", "lut": ["#041a30", "#2a7898", "#60f0ff"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "dots", "lut": ["#0c3a5a", "#40a8c0", "#e0f8ff"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "noise", "lut": ["#60f0ff", "#40a8c0", "#1c5878"], "scale": 1, "contrast": 1, "strength": 0.6},
    {"texture": "brushed", "lut": ["#2a7898", "#40d0e0", "#e0f8ff"], "scale": 1, "contrast": 1.2, "strength": 0.6},
    {"texture": "carbon", "lut": ["#40a8c0", "#40d0e0", "#60f0ff"], "scale": 1, "contrast": 1},
    {"texture": "diamond", "lut": ["#e0f8ff", "#60f0ff", "#40d0e0"], "scale": 1, "contrast": 1},
    {"texture": "clouds", "lut": ["#041a30", "#2a7898", "#60f0ff"], "scale": 2, "contrast": 1, "octaves": 4},
    {"texture": "cells", "lut": ["#0c3a5a", "#40a8c0", "#e0f8ff"], "scale": 1, "contrast": 1},
    {"texture": "marble", "lut": ["#60f0ff", "#40a8c0", "#1c5878"], "scale": 1, "contrast": 1, "frequency": 3, "strength": 1.5},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
