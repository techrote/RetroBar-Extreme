// RetroBar-Extreme example style: Carbon Racer.
// Shows: a carbon-fibre texture bar, racing-red accents, double-thick task button borders and
// a red Start recolour.
{
  "name": "Carbon Racer",
  "parts": {
    "bar": {
      "background": { "texture": "carbon", "lut": [ "#0a0a0a", "#2a2a2a", "#4a4a4a" ], "scale": 1, "contrast": 1 },
      "border": "#d01818"
    },
    "tray": {
      "background": { "texture": "carbon", "lut": [ "#050505", "#1a1a1a", "#303030" ], "scale": 1, "contrast": 1 },
      "border": "#d01818"
    },
    "button": {
      "background": { "angle": 90, "stops": [ "#3a3a3a", "#1c1c1c" ] },
      "border": "#000000",
      "foreground": "#f0f0f0"
    },
    "buttonHover": {
      "background": { "angle": 90, "stops": [ "#4a4a4a", "#2a2a2a" ] },
      "border": "#d01818"
    },
    "buttonActive": {
      "background": { "angle": 90, "stops": [ "#a00e0e", "#5a0606" ] },
      "border": "#ff4040",
      "foreground": "#ffffff"
    },
    "buttonFlashing": {
      "background": { "angle": 90, "stops": [ "#ffd000", "#c08000" ] },
      "border": "#000000",
      "foreground": "#000000"
    },
    "clock": { "foreground": "#ff4040" },
    "bevel": { "highlight": "#5a5a5a", "light": "#3a3a3a", "shadow": "#000000", "darkShadow": "#000000" }
  },
  "palette": [ "#2a2a2a", "#d01818", "#0a0a0a", "#ffd000", null, null, null, null, null, null, null, null ],
  "start": { "recolour": "#d01818" },
  "borders": { "button": 2, "buttonActive": 2 }
}
