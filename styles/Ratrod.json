// RetroBar-Extreme example style (UX-003): steel and gunmetal with one warm accent.
// To use it, copy this file to %LOCALAPPDATA%\RetroBar\Style.json. It applies at once over
// whatever theme is selected; delete the file to get the plain theme back.
// Parts left out keep the theme's own look. Classic themes (95-98, 2000, ...) draw the bar and
// tray with one colour, so "tray" only changes XP, Vista, Longhorn and Watercolor.
{
  "name": "Ratrod",
  "parts": {
    "bar": {
      "background": { "angle": 90, "stops": [ "#5a6066", "#3d4247", "#2b2f33" ] },
      "border": "#71777d"
    },
    "tray": {
      "background": { "angle": 90, "stops": [ "#33373b", "#24272a" ] },
      "border": "#1a1c1e"
    },
    "button": {
      "background": { "angle": 90, "stops": [ "#4e545a", "#3a3f44" ] },
      "border": "#24272a",
      "foreground": "#e8e4dc"
    },
    "buttonHover": {
      "background": { "angle": 90, "stops": [ "#5d646b", "#474d53" ] },
      "border": "#2b2f33"
    },
    "buttonActive": {
      "background": { "angle": 90, "stops": [ "#26292c", "#33373b" ] },
      "border": "#141617",
      "foreground": "#ffb35c"
    },
    "buttonFlashing": {
      "background": { "angle": 90, "stops": [ "#c8661e", "#8f4512" ] },
      "border": "#5e2d0b",
      "foreground": "#fff4e6"
    },
    "clock": {
      "foreground": "#ff9a3c"
    },
    "bevel": {
      "highlight": "#8a9096",
      "light": "#6b7177",
      "shadow": "#1f2225",
      "darkShadow": "#0e0f10"
    }
  },
  "palette": [ "#2b2f33", "#5a6066", "#3d4247", "#71777d", "#1a1c1e", "#e8e4dc", "#ffb35c", "#c8661e", null, null, null, null ],
  "texturePalette": [
    {"texture": "clouds", "lut": ["#1a1c1e", "#5a6066", "#ffb35c"], "scale": 2, "contrast": 1, "octaves": 4},
    {"texture": "cells", "lut": ["#2b2f33", "#71777d", "#e8e4dc"], "scale": 1, "contrast": 1},
    {"texture": "marble", "lut": ["#ffb35c", "#71777d", "#3d4247"], "scale": 1, "contrast": 1, "frequency": 3, "strength": 1.5},
    {"texture": "scanlines", "lut": ["#5a6066", "#c8661e", "#e8e4dc"], "scale": 1, "contrast": 1, "frequency": 32},
    {"texture": "weave", "lut": ["#71777d", "#c8661e", "#ffb35c"], "scale": 1, "contrast": 1},
    {"texture": "checker", "lut": ["#e8e4dc", "#ffb35c", "#c8661e"], "scale": 1, "contrast": 0.6, "frequency": 16},
    {"texture": "waves", "lut": ["#1a1c1e", "#5a6066", "#ffb35c"], "scale": 1, "contrast": 1, "frequency": 3, "octaves": 3},
    {"texture": "bricks", "lut": ["#2b2f33", "#71777d", "#e8e4dc"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "dots", "lut": ["#ffb35c", "#71777d", "#3d4247"], "scale": 1, "contrast": 1, "frequency": 12},
    {"texture": "noise", "lut": ["#5a6066", "#c8661e", "#e8e4dc"], "scale": 1, "contrast": 1, "strength": 0.6},
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null,
    null
  ]
}
