<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net6.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>RetroBar.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.0.0.8</AssemblyVersion>
    <FileVersion>1.0.0.8</FileVersion>
    <ApplicationIcon>Resources\retrobar.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;ARM64</Platforms>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
	<RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.EnableHardwareAccelerationInRdp" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
    <None Include="Languages\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
    <None Include="Themes\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
	<None Remove="Resources\desktop95-sm.png" />
	<None Remove="Resources\desktop95-lg.png" />
	<None Remove="Resources\help.png" />
    <None Remove="Resources\retrobar.ico" />
    <None Remove="Resources\shader_invert.ps" />
    <None Remove="Resources\start9x.png" />
    <None Remove="Languages\English.xaml" />
    <None Remove="Themes\System.xaml" />
  </ItemGroup>

  <!-- UXUI-Extreme (UX-006): raw copy of the built-in base theme, rescaled at load time for native sizing -->
  <ItemGroup>
    <EmbeddedResource Include="Themes\System.xaml" LogicalName="RetroBar.Themes.System.xaml" />
  </ItemGroup>

  <!-- UXUI-Extreme (UX-017): built-in fonts (pack://application:,,,/Fonts/), example styles for the
       Saved styles list, and the Extras folder (styles, icon pack, installable fonts) beside every
       build. Extras stay out of the single-file bundle so portable builds show them next to the exe. -->
  <ItemGroup>
    <Resource Include="..\extras\fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\styles\*.json" Exclude="..\styles\Broken.json" LogicalName="RetroBar.ExampleStyles.%(Filename).json" />
    <None Include="..\styles\*.json;..\styles\README.md;..\styles\preview.png" Exclude="..\styles\Broken.json" Link="Extras\Styles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\extras\icons\**\*" Link="Extras\Icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\extras\fonts\*.ttf;..\extras\fonts\OFL.txt;..\extras\fonts\README.md" Link="Extras\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="3.1.1" />
    <PackageReference Include="ManagedShell" Version="0.0.372" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="Resources\desktop95-sm.png" />
	<Resource Include="Resources\desktop95-lg.png" />
	<Resource Include="Resources\help.png" />
    <Resource Include="Resources\shader_invert.ps" />
    <Resource Include="Resources\retrobar.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\start9x.png" />
  </ItemGroup>

</Project>