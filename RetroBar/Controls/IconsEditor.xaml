<UserControl x:Class="RetroBar.Controls.IconsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Settings="clr-namespace:RetroBar.Utilities"
             IsVisibleChanged="IconsEditor_IsVisibleChanged">
    <!-- UXUI-Extreme: the Icons tab. Every picture RetroBar can replace: the Start button and its
         icon, quick launch items, notification area icons and the notification area toggle. -->
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding"
                    Value="4,2,4,2" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding"
                    Value="2,2,6,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin"
                    Value="0,1,0,1" />
            <Setter Property="MinHeight"
                    Value="21" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin"
                    Value="2,3,0,3" />
        </Style>
        <Style x:Key="PickButton"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="0" />
            <Setter Property="Padding"
                    Value="8,0" />
            <Setter Property="Margin"
                    Value="4,1,0,1" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <GroupBox x:Name="grpStartPics" Header="{DynamicResource uxui_icons_start_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_theme}"
                            Click="StartImageReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icons_start_3state}"
                            ToolTip="{DynamicResource uxui_icons_start_3state_tip}"
                            Click="StartImage3_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icons_start_1state}"
                            ToolTip="{DynamicResource uxui_icons_start_1state_tip}"
                            Click="StartImage1_OnClick" />
                    <Label>
                        <AccessText Text="{DynamicResource uxui_icons_start_graphic}" />
                    </Label>
                    <TextBlock x:Name="txtStartImage"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Left"
                           Margin="4,2,4,4"
                           Text="{DynamicResource uxui_icons_start_note}" />
                <DockPanel>
                    <Label Target="{Binding ElementName=cboStartIconAlign}">
                        <AccessText Text="{DynamicResource uxui_icons_icon_position}" />
                    </Label>
                    <ComboBox x:Name="cboStartIconAlign"
                              HorizontalAlignment="Right"
                              Width="230"
                              ItemsSource="{DynamicResource uxui_taskbuttons_align_values}"
                              SelectionChanged="StartIconAlign_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_theme}"
                            Click="StartIconReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="StartIconChoose_OnClick" />
                    <Label>
                        <AccessText Text="{DynamicResource uxui_layout_start_icon}" />
                    </Label>
                    <TextBlock x:Name="txtStartIcon"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="grpDesktopIcon" Header="{DynamicResource uxui_icons_desktop_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_theme}"
                            Click="DesktopIconReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="DesktopIconChoose_OnClick" />
                    <Label>
                        <AccessText Text="{DynamicResource uxui_layout_start_icon}" />
                    </Label>
                    <TextBlock x:Name="txtDesktopIcon"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboDesktopIconAlign}">
                        <AccessText Text="{DynamicResource uxui_icons_icon_position}" />
                    </Label>
                    <ComboBox x:Name="cboDesktopIconAlign"
                              HorizontalAlignment="Right"
                              Width="230"
                              ItemsSource="{DynamicResource uxui_taskbuttons_align_values}"
                              SelectionChanged="DesktopIconAlign_SelectionChanged" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="grpQuickIcons" Header="{DynamicResource uxui_icons_ql_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            x:Name="btnQuickLaunchReset"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icons_original}"
                            Click="QuickLaunchReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            x:Name="btnQuickLaunchChoose"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="QuickLaunchChoose_OnClick" />
                    <Label Target="{Binding ElementName=cboQuickLaunch}">
                        <AccessText Text="{DynamicResource uxui_icons_ql_item}" />
                    </Label>
                    <ComboBox x:Name="cboQuickLaunch"
                              DisplayMemberPath="Display"
                              SelectionChanged="QuickLaunch_SelectionChanged" />
                </DockPanel>
                <TextBlock x:Name="txtQuickLaunchHint"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Left"
                           Margin="4,0,4,2" />
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="grpTray" Header="{DynamicResource uxui_icons_tray_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            x:Name="btnTrayReset"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icons_original}"
                            Click="TrayReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            x:Name="btnTrayChoose"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="TrayChoose_OnClick" />
                    <Label Target="{Binding ElementName=cboTray}">
                        <AccessText Text="{DynamicResource uxui_icons_tray_item}" />
                    </Label>
                    <ComboBox x:Name="cboTray"
                              DisplayMemberPath="Display"
                              SelectionChanged="Tray_SelectionChanged" />
                </DockPanel>
                <TextBlock x:Name="txtTrayHint"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Left"
                           Margin="4,0,4,2" />
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="grpToggleIcon" Header="{DynamicResource uxui_toggle_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_theme}"
                            Click="ToggleIconReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PickButton}"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="ToggleIconChoose_OnClick" />
                    <Label>
                        <AccessText Text="{DynamicResource uxui_toggle_image}" />
                    </Label>
                    <TextBlock x:Name="txtToggleIcon"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=TrayToggleFlip, UpdateSourceTrigger=PropertyChanged}">
                    <Label Content="{DynamicResource uxui_toggle_flip}" />
                </CheckBox>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
