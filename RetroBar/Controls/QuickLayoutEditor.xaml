<UserControl x:Class="RetroBar.Controls.QuickLayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Settings="clr-namespace:RetroBar.Utilities"
             IsVisibleChanged="QuickLayoutEditor_IsVisibleChanged">
    <!-- UXUI-Extreme: the quick launch area's own layout (part of the Start/Quick tab): where it sits relative
         to the Start button, where its icons sit inside it, and how long it is. -->
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding"
                    Value="4,2,4,2" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding"
                    Value="2,2,6,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin"
                    Value="0,1,0,1" />
            <Setter Property="MinHeight"
                    Value="21" />
            <Setter Property="Width"
                    Value="193" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin"
                    Value="2,3,0,3" />
        </Style>
    </UserControl.Resources>
    <GroupBox Header="{DynamicResource uxui_quick_heading}">
        <StackPanel Orientation="Vertical">
            <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=ShowQuickLaunch, UpdateSourceTrigger=PropertyChanged}">
                <Label Content="{DynamicResource uxui_quick_show}" />
            </CheckBox>
            <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=QuickLaunchFirst, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{DynamicResource uxui_quick_first_tip}">
                <Label Content="{DynamicResource uxui_quick_first}" />
            </CheckBox>
            <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=QuickLaunchButtonFill, UpdateSourceTrigger=PropertyChanged}">
                <Label Content="{DynamicResource uxui_icons_ql_fill}" />
            </CheckBox>
            <DockPanel>
                <Label Target="{Binding ElementName=cboQuickH}">
                    <AccessText Text="{DynamicResource uxui_quick_align_h}" />
                </Label>
                <ComboBox x:Name="cboQuickH"
                          ItemsSource="{DynamicResource uxui_taskbuttons_align_values}"
                          SelectionChanged="Combo_SelectionChanged" />
            </DockPanel>
            <DockPanel>
                <Label Target="{Binding ElementName=cboQuickV}">
                    <AccessText Text="{DynamicResource uxui_quick_align_v}" />
                </Label>
                <ComboBox x:Name="cboQuickV"
                          ItemsSource="{DynamicResource uxui_valign_values}"
                          SelectionChanged="Combo_SelectionChanged" />
            </DockPanel>
            <DockPanel>
                <Label Target="{Binding ElementName=txtQuickLength}">
                    <AccessText Text="{DynamicResource uxui_quick_length}" />
                </Label>
                <Button DockPanel.Dock="Right"
                        MinWidth="0"
                        Padding="8,0"
                        Margin="4,1,0,1"
                        Content="{DynamicResource uxui_quick_length_auto}"
                        Click="QuickLengthAuto_OnClick" />
                <TextBox x:Name="txtQuickLength"
                         DockPanel.Dock="Right"
                         Width="50"
                         TextAlignment="Right"
                         VerticalAlignment="Center"
                         ToolTip="{DynamicResource uxui_quick_length_tip}"
                         TextChanged="TxtQuickLength_TextChanged" />
                <TextBlock />
            </DockPanel>
            <TextBlock TextWrapping="Wrap"
                       MaxWidth="360"
                       HorizontalAlignment="Left"
                       Margin="4,2,4,2"
                       Text="{DynamicResource uxui_quick_note}" />
        </StackPanel>
    </GroupBox>
</UserControl>
