<UserControl x:Class="RetroBar.Controls.DisplayProfilesEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Editor_Loaded">
    <StackPanel Width="580">
        <TextBlock Text="Independent display taskbars" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Text="Choose which displays have taskbars, their docking edges and the windows each one shows. No fullscreen dashboard is enabled by this feature."
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <CheckBox x:Name="ProfilesActive" Content="Enable independent display profiles (opt in)"
                  Checked="ProfilesActive_Changed" Unchecked="ProfilesActive_Changed" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Connected monitors" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="DisplayPicker" Height="210" SelectionChanged="DisplayPicker_SelectionChanged"/>
                <Button Content="Refresh displays" Click="Refresh_Click" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Height="365">
                <StackPanel x:Name="ProfileFields">
                    <CheckBox x:Name="BarEnabled" Content="Show RetroBar on this monitor" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Docking edge" VerticalAlignment="Center"/>
                        <ComboBox x:Name="EdgePicker" Grid.Column="1" MinWidth="155"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Window source" VerticalAlignment="Center"/>
                        <ComboBox x:Name="WindowSourcePicker" Grid.Column="1" MinWidth="155"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Horizontal rows" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsText" Grid.Column="1" Width="55" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Vertical width units" VerticalAlignment="Center"/>
                        <TextBox x:Name="WidthText" Grid.Column="1" Width="55" HorizontalAlignment="Left"/>
                    </Grid>
                    <CheckBox x:Name="AutoHide" Content="Auto-hide taskbar"/>
                    <CheckBox x:Name="ShowDesktop" Content="Show Desktop button"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ShowStart" Content="Start button" Margin="0,2,10,2"/>
                        <CheckBox x:Name="ShowQuickLaunch" Content="Quick launch" Margin="0,2,0,2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ShowTray" Content="Notifications" Margin="0,2,10,2"/>
                        <CheckBox x:Name="ShowClock" Content="Clock" Margin="0,2,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Include apps (blank means all)" FontWeight="SemiBold" Margin="0,9,0,3"/>
                    <TextBox x:Name="IncludeApps" MinWidth="200" ToolTip="Comma-separated exe names, app IDs, or 'terminals' family" />
                    <TextBlock Text="Exclude apps" FontWeight="SemiBold" Margin="0,7,0,3"/>
                    <TextBox x:Name="ExcludeApps" MinWidth="200" ToolTip="Comma-separated exe names or app IDs"/>
                    <TextBlock Text="Examples: terminals, firefox.exe, explorer.exe. Includes and excludes match independently of the window's monitor."
                               TextWrapping="Wrap" Margin="0,4,0,8" FontSize="11"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply monitor profile" Click="Apply_Click" Padding="10,3" Margin="0,0,6,0"/>
                        <Button Content="Restore inherited defaults" Click="Restore_Click" Padding="10,3"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Text="Safety: if all enabled displays are unavailable, a temporary recovery bar opens on the primary monitor. Disabled profiles leave original global settings intact. Display identity currently follows Windows device name."
                   Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"/>
    </StackPanel>
</UserControl>
