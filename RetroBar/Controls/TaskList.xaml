<UserControl x:Class="RetroBar.Controls.TaskList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:local="clr-namespace:RetroBar.Controls"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:dd="urn:gong-wpf-dragdrop"
             Loaded="TaskList_OnLoaded"
             Unloaded="TaskList_OnUnloaded"
             SizeChanged="TaskList_OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:DockOrientationConverter x:Key="dockOrientationConverter" />
            <converters:ThumbOverlayConverter x:Key="thumbOverlayConverter" />
            <converters:EdgeOrientationConverter x:Key="orientationConverter" />
            <converters:TaskButtonWidthConverter x:Key="taskButtonWidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <!-- UXUI-Extreme: this grip is the quick launch area's edge: dragging it resizes quick launch -->
        <!-- UXUI-Extreme: the grip hangs over its neighbour's edge instead of taking room, so the unlocked
             and locked taskbars are laid out identically -->
        <Grid>
            <Grid.Width>
                <Binding Converter="{StaticResource thumbOverlayConverter}" ConverterParameter="width" Path="Orientation" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
            </Grid.Width>
            <Grid.Height>
                <Binding Converter="{StaticResource thumbOverlayConverter}" ConverterParameter="height" Path="Orientation" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
            </Grid.Height>
            <DockPanel.Dock>
                <Binding Converter="{StaticResource dockOrientationConverter}"
                             ConverterParameter="leading"
                             Path="Orientation"
                             RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
            </DockPanel.Dock>
            <Thumb Style="{DynamicResource ToolbarThumb}" MouseEnter="QuickLaunchGrip_MouseEnter" DragDelta="QuickLaunchGrip_DragDelta" DragCompleted="QuickLaunchGrip_DragCompleted" MouseDoubleClick="QuickLaunchGrip_MouseDoubleClick" ToolTip="{DynamicResource uxui_quicklaunch_grip_tip}">
                <Thumb.HorizontalAlignment>
                    <Binding Converter="{StaticResource thumbOverlayConverter}" ConverterParameter="h" Path="Orientation" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                </Thumb.HorizontalAlignment>
                <Thumb.VerticalAlignment>
                    <Binding Converter="{StaticResource thumbOverlayConverter}" ConverterParameter="v" Path="Orientation" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                </Thumb.VerticalAlignment>
            </Thumb>
        </Grid>
        <ScrollViewer Style="{DynamicResource TaskListScrollViewer}"
                      x:Name="TasksScrollViewer"
                      Focusable="False"
                      PreviewMouseWheel="TasksScrollViewer_PreviewMouseWheel"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TasksList"
                          Focusable="False"
                          HorizontalAlignment="Stretch"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DragDropContext="TaskList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:TaskRowPanel Style="{DynamicResource TaskListWrapPanel}">
                            <WrapPanel.Orientation>
                                <Binding Converter="{StaticResource orientationConverter}"
                                         Path="Orientation"
                                         RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                            </WrapPanel.Orientation>
                        </local:TaskRowPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <ItemContainerTemplate>
                        <local:TaskButton Host="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:TaskList}}">
                            <local:TaskButton.Width>
                                <MultiBinding Converter="{StaticResource taskButtonWidthConverter}">
                                    <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}" />
                                    <Binding Path="ButtonWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="ExtraWidthCount" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="ButtonsPerRow" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <!-- UXUI-Extreme (UX-014): per-app width -->
                                    <Binding />
                                    <Binding Source="{x:Static utilities:Settings.Instance}" Path="TaskButtonAppRules" />
                                    <Binding Path="ButtonMarginTotal" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="IconOnlyWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="DefaultWidthWithMargin" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                </MultiBinding>
                            </local:TaskButton.Width>
                        </local:TaskButton>
                    </ItemContainerTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
