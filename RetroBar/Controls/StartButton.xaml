<UserControl x:Class="RetroBar.Controls.StartButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <ToggleButton ToolTip="{DynamicResource StartButtonTip}"
                  Click="Start_OnClick"
                  DragEnter="Start_DragEnter"
                  DragLeave="Start_DragLeave"
                  PreviewMouseLeftButtonDown="Start_OnPreviewMouseLeftButtonDown"
                  MouseRightButtonUp="Start_OnMouseRightButtonUp"
                  Name="Start"
                  Style="{DynamicResource StartButton}">
        <Grid x:Name="StartContentGrid">
            <!-- UXUI-Extreme: spacer columns let the icon and label sit left, centred or right -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StartLeadColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="StartLabelColumn" Width="*" />
                <ColumnDefinition x:Name="StartTrailColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="1"
                   x:Name="StartIconImage"
                   Style="{DynamicResource StartIcon}" />
            <TextBlock Grid.Column="2"
                       x:Name="StartLabelText"
                       Style="{DynamicResource StartLabel}" />
        </Grid>
    </ToggleButton>
</UserControl>
