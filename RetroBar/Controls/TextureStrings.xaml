<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- UXUI-Extreme (UX-011): English fallback for new controls; existing mode labels stay translated. -->
    <sys:String x:Key="uxui_texture_mode">Texture</sys:String>
    <sys:String x:Key="uxui_texture_pattern">Pattern</sys:String>
    <sys:String x:Key="uxui_texture_ratrod">Ratrod brushed</sys:String>
    <sys:String x:Key="uxui_texture_theme">Theme scanlines</sys:String>
    <sys:String x:Key="uxui_texture_palette">Use palette (all occupied slots, in order)</sys:String>
    <sys:String x:Key="uxui_texture_add">Add LUT colour</sys:String>
    <sys:String x:Key="uxui_texture_remove">Remove LUT colour</sys:String>
    <sys:String x:Key="uxui_texture_scale">Scale ×</sys:String>
    <sys:String x:Key="uxui_texture_contrast">Contrast ×</sys:String>
    <sys:String x:Key="uxui_texture_angle">Angle °</sys:String> <!-- UX-013 -->
    <sys:String x:Key="uxui_texture_seed">Seed</sys:String>
    <sys:String x:Key="uxui_texture_octaves">Octaves</sys:String>
    <sys:String x:Key="uxui_texture_frequency">Frequency</sys:String>
    <sys:String x:Key="uxui_texture_strength">Strength</sys:String>
    <sys:String x:Key="uxui_texture_brightness">Brightness</sys:String>
    <sys:String x:Key="uxui_texture_saturation">Saturation ×</sys:String>
    <sys:String x:Key="uxui_texture_white">White level</sys:String>
    <sys:String x:Key="uxui_texture_resample">Scaling</sys:String>
    <sys:String x:Key="uxui_texture_sharpen">Sharpen</sys:String>
    <sys:String x:Key="uxui_texture_sharpen_radius">Radius px</sys:String>
    <sys:String x:Key="uxui_texture_resample_smooth">Smooth (display)</sys:String>
    <sys:String x:Key="uxui_texture_resample_nearest">Nearest (pixels)</sys:String>
    <sys:String x:Key="uxui_texture_resample_box">Box</sys:String>
    <sys:String x:Key="uxui_texture_resample_triangle">Triangle (bilinear)</sys:String>
    <sys:String x:Key="uxui_texture_resample_hermite">Hermite</sys:String>
    <sys:String x:Key="uxui_texture_resample_gaussian">Gaussian (soft)</sys:String>
    <sys:String x:Key="uxui_texture_resample_mitchell">Mitchell</sys:String>
    <sys:String x:Key="uxui_texture_resample_catrom">Catmull-Rom (bicubic)</sys:String>
    <sys:String x:Key="uxui_texture_resample_lanczos">Lanczos (sharp)</sys:String>
    <sys:String x:Key="uxui_texture_preset">Preset</sys:String>
    <sys:String x:Key="uxui_texture_preset_tip">Five built-in presets for this pattern, then your own (★). A preset sets the pattern and its settings and keeps your colours.</sys:String>
    <sys:String x:Key="uxui_texture_preset_save">Save...</sys:String>
    <sys:String x:Key="uxui_texture_preset_save_tip">Save this texture's settings as one of your presets</sys:String>
    <sys:String x:Key="uxui_texture_preset_name">Name for this preset:</sys:String>
    <sys:String x:Key="uxui_texture_preset_delete">Delete</sys:String>
    <sys:String x:Key="uxui_texture_preset_import">Import...</sys:String>
    <sys:String x:Key="uxui_texture_preset_import_tip">Add presets from a file (a list of texture configs, or one)</sys:String>
    <sys:String x:Key="uxui_texture_preset_export">Export...</sys:String>
    <sys:String x:Key="uxui_texture_preset_export_tip">Save all your presets to a file (or this texture, if you have none)</sys:String>
    <sys:String x:Key="uxui_texture_preset_filter">Texture presets (*.json)|*.json|All files (*.*)|*.*</sys:String>
    <sys:String x:Key="uxui_texture_preset_imported">Imported {0} preset(s). They are in the list, marked with a star.</sys:String>
    <sys:String x:Key="uxui_texture_preset_import_failed">Could not import:</sys:String>
    <sys:String x:Key="uxui_texture_preset_exported">Exported {0} preset(s).</sys:String>
    <sys:String x:Key="uxui_texture_config">Config</sys:String>
    <sys:String x:Key="uxui_texture_config_tip">This texture as text, the same form a style file uses. Edit it and press Apply or Enter, or paste a config from anywhere.</sys:String>
    <sys:String x:Key="uxui_texture_config_copy">Copy</sys:String>
    <sys:String x:Key="uxui_texture_config_paste">Paste</sys:String>
    <sys:String x:Key="uxui_texture_config_paste_tip">Use the config on the clipboard</sys:String>
    <sys:String x:Key="uxui_texture_config_apply">Apply</sys:String>
    <sys:String x:Key="uxui_texture_config_apply_tip">Use the text in the field</sys:String>
    <sys:String x:Key="uxui_texture_config_copied">Copied to the clipboard.</sys:String>
    <sys:String x:Key="uxui_texture_config_clipboard">The clipboard has no text to use.</sys:String>
    <sys:String x:Key="uxui_texture_config_failed">That text isn't a texture config:</sys:String>
    <sys:String x:Key="uxui_texture_slot">Palette slot</sys:String>
    <sys:String x:Key="uxui_texture_slot_use">Use</sys:String>
    <sys:String x:Key="uxui_texture_slot_use_tip">Use the texture saved in this slot, colours and all</sys:String>
    <sys:String x:Key="uxui_texture_slot_store">Store</sys:String>
    <sys:String x:Key="uxui_texture_slot_store_tip">Save this texture into the slot</sys:String>
    <sys:String x:Key="uxui_texture_slot_empty">That slot is empty.</sys:String>
    <sys:String x:Key="uxui_texture_slot_stored">Stored in slot {0}.</sys:String>
    <sys:String x:Key="uxui_texpal_heading">Texture palette</sys:String>
    <sys:String x:Key="uxui_texpal_clear">Clear</sys:String>
    <sys:String x:Key="uxui_texpal_paste_tip">Put the clipboard's texture config in the selected slot</sys:String>
    <sys:String x:Key="uxui_texpal_empty_tip">Slot {0} is empty</sys:String>
    <sys:String x:Key="uxui_texpal_selected">Slot {0} selected</sys:String>
    <sys:String x:Key="uxui_palette_fill">Fill with complementary</sys:String>
    <sys:String x:Key="uxui_palette_fill_tip">Fill every empty slot with colours that go with the ones you have chosen: complements first, then neighbouring hues, then lighter and darker relatives.</sys:String>
    <sys:String x:Key="uxui_palette_fill_need">Choose at least one colour first.</sys:String>
    <sys:String x:Key="uxui_texture_hint">LUT colours run from dark to light grey. PNG files: %LOCALAPPDATA%\RetroBar\Textures\ (reopen Texture mode to refresh the list).</sys:String>
    <sys:String x:Key="uxui_texture_fallback">Texture unavailable; this property uses the theme default.</sys:String>
</ResourceDictionary>
