<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- UXUI-Extreme (UX-011): English fallback for new controls; existing mode labels stay translated. -->
    <sys:String x:Key="uxui_texture_mode">Texture</sys:String>
    <sys:String x:Key="uxui_texture_pattern">Pattern</sys:String>
    <sys:String x:Key="uxui_texture_ratrod">Ratrod brushed</sys:String>
    <sys:String x:Key="uxui_texture_theme">Theme scanlines</sys:String>
    <sys:String x:Key="uxui_texture_palette">Use palette (all occupied slots, in order)</sys:String>
    <sys:String x:Key="uxui_texture_add">Add LUT colour</sys:String>
    <sys:String x:Key="uxui_texture_remove">Remove LUT colour</sys:String>
    <sys:String x:Key="uxui_texture_scale">Scale ×</sys:String>
    <sys:String x:Key="uxui_texture_contrast">Contrast ×</sys:String>
    <sys:String x:Key="uxui_texture_hint">LUT colours run from dark to light grey. PNG files: %LOCALAPPDATA%\RetroBar\Textures\ (reopen Texture mode to refresh the list).</sys:String>
    <sys:String x:Key="uxui_texture_fallback">Texture unavailable; this property uses the theme default.</sys:String>
</ResourceDictionary>
