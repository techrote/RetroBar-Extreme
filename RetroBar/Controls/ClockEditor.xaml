<UserControl x:Class="RetroBar.Controls.ClockEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Settings="clr-namespace:RetroBar.Utilities"
             IsVisibleChanged="ClockEditor_IsVisibleChanged">
    <!-- UXUI-Extreme: the Clock tab. How the clock is turned and spaced, and its own font. -->
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding"
                    Value="4,2,4,2" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding"
                    Value="2,2,6,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin"
                    Value="0,1,0,1" />
            <Setter Property="MinHeight"
                    Value="21" />
            <Setter Property="Width"
                    Value="193" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin"
                    Value="2,3,0,3" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width"
                    Value="120" />
            <Setter Property="Margin"
                    Value="0,2,6,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="IsSnapToTickEnabled"
                    Value="True" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
                    Orientation="Vertical">
            <GroupBox Header="{DynamicResource uxui_clock_position_heading}">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboClockOrientation}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_orientation}" />
                        </Label>
                        <ComboBox x:Name="cboClockOrientation"
                                  ItemsSource="{DynamicResource uxui_layout_orientation_values}"
                                  SelectionChanged="Combo_SelectionChanged" />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboClockMargin}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_margins}" />
                        </Label>
                        <ComboBox x:Name="cboClockMargin"
                                  ItemsSource="{DynamicResource uxui_layout_clock_margin_values}"
                                  SelectionChanged="Combo_SelectionChanged" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=ClockCustomMargin, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_layout_clock_outer}" />
                    </CheckBox>
                    <DockPanel>
                        <TextBox x:Name="txtClockMargin"
                                 DockPanel.Dock="Right"
                                 Width="110"
                                 Margin="0,0,0,2"
                                 VerticalAlignment="Center"
                                 ToolTip="{DynamicResource uxui_layout_clock_outer_tip}"
                                 TextChanged="TxtClockMargin_TextChanged" />
                        <TextBlock />
                    </DockPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="{DynamicResource uxui_clock_digits_heading}">
                <StackPanel Orientation="Vertical">
                    <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=ClockMonospace, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_layout_clock_mono}" />
                    </CheckBox>
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboClockMono}">
                            <AccessText Text="{DynamicResource uxui_clock_mono_font}" />
                        </Label>
                        <ComboBox x:Name="cboClockMono"
                                  ToolTip="{DynamicResource uxui_layout_clock_mono_tip}"
                                  SelectionChanged="Combo_SelectionChanged" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap"
                               MaxWidth="300"
                               HorizontalAlignment="Left"
                               Margin="4,2,4,2"
                               Text="{DynamicResource uxui_layout_clock_mono_tip}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Vertical">
            <GroupBox Header="{DynamicResource uxui_clock_font_heading}">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboClockFont}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_font}" />
                        </Label>
                        <ComboBox x:Name="cboClockFont"
                                  SelectionChanged="Combo_SelectionChanged" />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboClockWeight}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_weight}" />
                        </Label>
                        <ComboBox x:Name="cboClockWeight"
                                  SelectionChanged="Combo_SelectionChanged" />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboClockItalic}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_italic}" />
                        </Label>
                        <ComboBox x:Name="cboClockItalic"
                                  ItemsSource="{DynamicResource uxui_layout_clock_italic_values}"
                                  SelectionChanged="Combo_SelectionChanged" />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=sldClockSize}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_size}" />
                        </Label>
                        <TextBlock x:Name="txtClockSize"
                                   DockPanel.Dock="Right"
                                   Width="80" />
                        <Slider x:Name="sldClockSize"
                                DockPanel.Dock="Right"
                                Width="83"
                                Minimum="0"
                                Maximum="40"
                                TickFrequency="1"
                                Value="{Binding Source={x:Static Settings:Settings.Instance}, Path=ClockFontSize, UpdateSourceTrigger=PropertyChanged}"
                                ValueChanged="Slider_ValueChanged" />
                        <TextBlock />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=sldClockSpacing}">
                            <AccessText Text="{DynamicResource uxui_layout_clock_spacing}" />
                        </Label>
                        <TextBlock x:Name="txtClockSpacing"
                                   DockPanel.Dock="Right"
                                   Width="80" />
                        <Slider x:Name="sldClockSpacing"
                                DockPanel.Dock="Right"
                                Width="83"
                                Minimum="0.5"
                                Maximum="1.6"
                                TickFrequency="0.05"
                                ValueChanged="SldClockSpacing_ValueChanged" />
                        <TextBlock />
                    </DockPanel>
                </StackPanel>
            </GroupBox>
            <TextBlock TextWrapping="Wrap"
                       MaxWidth="330"
                       HorizontalAlignment="Left"
                       Margin="4,0,4,0"
                       Text="{DynamicResource uxui_clock_note}" />
        </StackPanel>
    </Grid>
</UserControl>
