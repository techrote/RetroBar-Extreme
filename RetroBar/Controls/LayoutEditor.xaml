<UserControl x:Class="RetroBar.Controls.LayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Settings="clr-namespace:RetroBar.Utilities"
             IsVisibleChanged="LayoutEditor_IsVisibleChanged">
    <!-- UXUI-Extreme (UX-012): the Layout tab. Start button orientation and size, where the
         Show desktop button goes, and the clock's orientation and own font. -->
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding"
                    Value="4,2,4,2" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding"
                    Value="2,2,6,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin"
                    Value="0,1,0,1" />
            <Setter Property="MinHeight"
                    Value="21" />
            <Setter Property="Width"
                    Value="193" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin"
                    Value="2,3,0,3" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width"
                    Value="120" />
            <Setter Property="Margin"
                    Value="0,2,6,2" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="IsSnapToTickEnabled"
                    Value="True" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <GroupBox Header="{DynamicResource uxui_layout_start_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Label Target="{Binding ElementName=cboStartOrientation}">
                        <AccessText Text="{DynamicResource uxui_layout_orientation}" />
                    </Label>
                    <ComboBox x:Name="cboStartOrientation"
                              ItemsSource="{DynamicResource uxui_layout_orientation_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboStartLength}">
                        <AccessText Text="{DynamicResource uxui_layout_length}" />
                    </Label>
                    <ComboBox x:Name="cboStartLength"
                              ItemsSource="{DynamicResource uxui_layout_size_mode_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel x:Name="rowStartLengthPx">
                    <TextBlock x:Name="txtStartLength"
                               DockPanel.Dock="Right"
                               Width="60" />
                    <Slider x:Name="sldStartLength"
                            DockPanel.Dock="Right"
                            Minimum="20"
                            Maximum="300"
                            TickFrequency="2"
                            Value="{Binding Source={x:Static Settings:Settings.Instance}, Path=StartButtonLengthPx, UpdateSourceTrigger=PropertyChanged}"
                            ValueChanged="Slider_ValueChanged" />
                    <TextBlock />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboStartStretch}">
                        <AccessText Text="{DynamicResource uxui_layout_stretch}" />
                    </Label>
                    <ComboBox x:Name="cboStartStretch"
                              ItemsSource="{DynamicResource uxui_layout_stretch_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboStartThickness}">
                        <AccessText Text="{DynamicResource uxui_layout_thickness}" />
                    </Label>
                    <ComboBox x:Name="cboStartThickness"
                              ItemsSource="{DynamicResource uxui_layout_size_mode_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel x:Name="rowStartThicknessPx">
                    <TextBlock x:Name="txtStartThickness"
                               DockPanel.Dock="Right"
                               Width="60" />
                    <Slider x:Name="sldStartThickness"
                            DockPanel.Dock="Right"
                            Minimum="10"
                            Maximum="150"
                            TickFrequency="1"
                            Value="{Binding Source={x:Static Settings:Settings.Instance}, Path=StartButtonThicknessPx, UpdateSourceTrigger=PropertyChanged}"
                            ValueChanged="Slider_ValueChanged" />
                    <TextBlock />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboStartAnchor}">
                        <AccessText Text="{DynamicResource uxui_layout_anchor}" />
                    </Label>
                    <ComboBox x:Name="cboStartAnchor"
                              ItemsSource="{DynamicResource uxui_layout_anchor_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <!-- UX-015: user PNG for the Start icon -->
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            MinWidth="0"
                            Padding="8,0"
                            Margin="4,1,0,1"
                            Content="{DynamicResource uxui_icon_theme}"
                            Click="StartIconReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            MinWidth="0"
                            Padding="8,0"
                            Margin="4,1,0,1"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="StartIconChoose_OnClick" />
                    <Label>
                        <AccessText Text="{DynamicResource uxui_layout_start_icon}" />
                    </Label>
                    <TextBlock x:Name="txtStartIcon"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=StartButtonShowIcon, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_layout_show_icon}" />
                    </CheckBox>
                    <CheckBox Margin="16,3,0,3"
                              IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=StartButtonShowText, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_layout_show_text}" />
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource uxui_layout_show_desktop_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Label Target="{Binding ElementName=cboShowDesktopPosition}">
                        <AccessText Text="{DynamicResource uxui_layout_position}" />
                    </Label>
                    <ComboBox x:Name="cboShowDesktopPosition"
                              ItemsSource="{DynamicResource uxui_layout_show_desktop_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=ShowDesktopButton, UpdateSourceTrigger=PropertyChanged}">
                    <Label Content="{DynamicResource uxui_layout_show_desktop_on}" />
                </CheckBox>
            </StackPanel>
        </GroupBox>
        <!-- UX-016: notification area expand/collapse toggle: custom image and margins -->
        <GroupBox Header="{DynamicResource uxui_toggle_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            MinWidth="0"
                            Padding="8,0"
                            Margin="4,1,0,1"
                            Content="{DynamicResource uxui_icon_theme}"
                            Click="ToggleIconReset_OnClick" />
                    <Button DockPanel.Dock="Right"
                            MinWidth="0"
                            Padding="8,0"
                            Margin="4,1,0,1"
                            Content="{DynamicResource uxui_icon_choose}"
                            Click="ToggleIconChoose_OnClick" />
                    <Label>
                        <AccessText Text="{DynamicResource uxui_toggle_image}" />
                    </Label>
                    <TextBlock x:Name="txtToggleIcon"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=TrayToggleFlip, UpdateSourceTrigger=PropertyChanged}">
                    <Label Content="{DynamicResource uxui_toggle_flip}" />
                </CheckBox>
                <DockPanel>
                    <TextBox x:Name="txtToggleMargin"
                             DockPanel.Dock="Right"
                             Width="110"
                             VerticalAlignment="Center"
                             ToolTip="{DynamicResource uxui_toggle_margin_tip}"
                             TextChanged="TxtToggleMargin_TextChanged" />
                    <CheckBox x:Name="chkToggleMargin"
                              IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=TrayToggleCustomMargin, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_toggle_margin}" />
                    </CheckBox>
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <!-- UX-014: task buttons for all apps, and remembered per-app settings -->
        <GroupBox Header="{DynamicResource uxui_taskbuttons_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Label Target="{Binding ElementName=cboTaskWidth}">
                        <AccessText Text="{DynamicResource uxui_taskbuttons_width}" />
                    </Label>
                    <ComboBox x:Name="cboTaskWidth"
                              ItemsSource="{DynamicResource uxui_taskbuttons_width_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel x:Name="rowTaskWidthPx">
                    <TextBlock x:Name="txtTaskWidth"
                               DockPanel.Dock="Right"
                               Width="60" />
                    <Slider x:Name="sldTaskWidth"
                            DockPanel.Dock="Right"
                            Minimum="30"
                            Maximum="400"
                            TickFrequency="5"
                            ValueChanged="SldTaskWidth_ValueChanged" />
                    <TextBlock />
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=TaskButtonShowIcons, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_taskbuttons_show_icons}" />
                    </CheckBox>
                    <CheckBox Margin="16,3,0,3"
                              IsChecked="{Binding Source={x:Static Settings:Settings.Instance}, Path=TaskButtonShowLabels, UpdateSourceTrigger=PropertyChanged}">
                        <Label Content="{DynamicResource uxui_taskbuttons_show_labels}" />
                    </CheckBox>
                </StackPanel>
                <DockPanel Margin="0,4,0,0">
                    <Label Target="{Binding ElementName=cboApp}">
                        <AccessText Text="{DynamicResource uxui_taskbuttons_app}" />
                    </Label>
                    <ComboBox x:Name="cboApp"
                              DisplayMemberPath="Name"
                              SelectionChanged="CboApp_SelectionChanged" />
                </DockPanel>
                <StackPanel x:Name="panelApp"
                            Orientation="Vertical"
                            Margin="14,0,0,0">
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboAppWidth}">
                            <AccessText Text="{DynamicResource uxui_taskbuttons_app_width}" />
                        </Label>
                        <ComboBox x:Name="cboAppWidth"
                                  Width="179"
                                  ItemsSource="{DynamicResource uxui_taskbuttons_app_width_values}"
                                  SelectionChanged="AppCombo_SelectionChanged" />
                    </DockPanel>
                    <DockPanel x:Name="rowAppWidthPx">
                        <TextBlock x:Name="txtAppWidth"
                                   DockPanel.Dock="Right"
                                   Width="60" />
                        <Slider x:Name="sldAppWidth"
                                DockPanel.Dock="Right"
                                Minimum="30"
                                Maximum="400"
                                TickFrequency="5"
                                ValueChanged="SldAppWidth_ValueChanged" />
                        <TextBlock />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboAppIcon}">
                            <AccessText Text="{DynamicResource uxui_taskbuttons_app_icon}" />
                        </Label>
                        <ComboBox x:Name="cboAppIcon"
                                  Width="179"
                                  ItemsSource="{DynamicResource uxui_taskbuttons_override_values}"
                                  SelectionChanged="AppCombo_SelectionChanged" />
                    </DockPanel>
                    <DockPanel>
                        <Label Target="{Binding ElementName=cboAppLabel}">
                            <AccessText Text="{DynamicResource uxui_taskbuttons_app_label}" />
                        </Label>
                        <ComboBox x:Name="cboAppLabel"
                                  Width="179"
                                  ItemsSource="{DynamicResource uxui_taskbuttons_override_values}"
                                  SelectionChanged="AppCombo_SelectionChanged" />
                    </DockPanel>
                    <Button HorizontalAlignment="Right"
                            MinWidth="0"
                            Padding="8,0"
                            Margin="0,2,0,2"
                            Content="{DynamicResource uxui_taskbuttons_forget}"
                            Click="ForgetApp_OnClick" />
                </StackPanel>
                <TextBlock x:Name="txtNoApps"
                           TextWrapping="Wrap"
                           Margin="4,2,4,2"
                           Text="{DynamicResource uxui_taskbuttons_hint}" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource uxui_layout_clock_heading}">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <Label Target="{Binding ElementName=cboClockOrientation}">
                        <AccessText Text="{DynamicResource uxui_layout_clock_orientation}" />
                    </Label>
                    <ComboBox x:Name="cboClockOrientation"
                              ItemsSource="{DynamicResource uxui_layout_orientation_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboClockFont}">
                        <AccessText Text="{DynamicResource uxui_layout_clock_font}" />
                    </Label>
                    <ComboBox x:Name="cboClockFont"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboClockWeight}">
                        <AccessText Text="{DynamicResource uxui_layout_clock_weight}" />
                    </Label>
                    <ComboBox x:Name="cboClockWeight"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=cboClockItalic}">
                        <AccessText Text="{DynamicResource uxui_layout_clock_italic}" />
                    </Label>
                    <ComboBox x:Name="cboClockItalic"
                              ItemsSource="{DynamicResource uxui_layout_clock_italic_values}"
                              SelectionChanged="Combo_SelectionChanged" />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=sldClockSize}">
                        <AccessText Text="{DynamicResource uxui_layout_clock_size}" />
                    </Label>
                    <TextBlock x:Name="txtClockSize"
                               DockPanel.Dock="Right"
                               Width="110" />
                    <Slider x:Name="sldClockSize"
                            DockPanel.Dock="Right"
                            Width="83"
                            Minimum="0"
                            Maximum="40"
                            TickFrequency="1"
                            Value="{Binding Source={x:Static Settings:Settings.Instance}, Path=ClockFontSize, UpdateSourceTrigger=PropertyChanged}"
                            ValueChanged="Slider_ValueChanged" />
                    <TextBlock />
                </DockPanel>
                <DockPanel>
                    <Label Target="{Binding ElementName=sldClockSpacing}">
                        <AccessText Text="{DynamicResource uxui_layout_clock_spacing}" />
                    </Label>
                    <TextBlock x:Name="txtClockSpacing"
                               DockPanel.Dock="Right"
                               Width="110" />
                    <Slider x:Name="sldClockSpacing"
                            DockPanel.Dock="Right"
                            Width="83"
                            Minimum="0.5"
                            Maximum="1.6"
                            TickFrequency="0.05"
                            ValueChanged="SldClockSpacing_ValueChanged" />
                    <TextBlock />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <TextBlock TextWrapping="Wrap"
                   MaxWidth="400"
                   HorizontalAlignment="Left"
                   Margin="4,0,4,0"
                   Text="{DynamicResource uxui_layout_note}" />
    </StackPanel>
</UserControl>
