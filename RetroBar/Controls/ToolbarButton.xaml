<UserControl x:Class="RetroBar.Controls.ToolbarButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="IconButton"
                ToolTip="{Binding Path=DisplayName}"
                Style="{DynamicResource ToolbarButton}">
            <Image Style="{DynamicResource ToolbarIcon}"
                   Name="ToolbarIcon" />
        </Button>
    </Grid>
</UserControl>
